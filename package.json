{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-graphify-init",
  "version": "0.1.6",
  "packageManager": "pnpm@10.34.5",
  "description": "Consent-aware OpenCode plugin that refreshes Graphify graphs in the background.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist/",
    "commands/",
    "docs/",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bash scripts/test-graphify-init.sh && node tests/command-registration.test.mjs && node tests/validate-pr-title.test.mjs && node tests/release-policy.test.mjs && node tests/package-publication.test.mjs && node tests/ci-workflow.test.mjs && node tests/publish-workflow.test.mjs && pnpm run test:install",
    "test:install": "node tests/clean-cache-install.test.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:workflows": "node scripts/verify-workflow-actions.mjs",
    "security:audit": "pnpm audit --audit-level=low",
    "security:signatures": "node scripts/verify-registry-signatures.mjs",
    "security:check": "pnpm run security:audit && pnpm run security:signatures",
    "check": "pnpm run typecheck && pnpm run verify:workflows && pnpm run build && pnpm run test && pnpm run verify:package"
  },
  "engines": {
    "node": ">=22.0.0",
    "opencode": ">=1.17.15 <2"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.13",
    "@types/node": "26.2.0",
    "esbuild": "0.28.1",
    "opencode-ai": "1.18.13",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresnator/opencode-graphify-init.git"
  },
  "bugs": {
    "url": "https://github.com/andresnator/opencode-graphify-init/issues"
  },
  "homepage": "https://github.com/andresnator/opencode-graphify-init#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "graphify",
    "code-graph",
    "indexing"
  ]
}
